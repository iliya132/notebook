# The release script resolves live hosts and reads the password from Lockbox.
# A local database fallback is intentionally not supported.
YC_POSTGRESQL_CLUSTER_ID=c9qrtrrook3e3umj7n4k
YC_POSTGRESQL_DATABASE=iliya132-db
SPRING_DATASOURCE_USERNAME=iliya132
LOCKBOX_SECRET_ID=e6q18smvei2glc3po3vt
LOCKBOX_SECRET_KEY=postgresql_password

APP_PORT=5173
APP_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
BACKEND_BIND_ADDRESS=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# Set to true only when the public URL uses HTTPS.
SESSION_COOKIE_SECURE=false

# Optional JVM container limit tuning.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
